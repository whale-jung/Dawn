{% doc %}
  Renders the header menu's content

  @param {object} [section] - The current header section context, supplied implicitly when rendered from that section and used for menu settings.
  @param {object} [block] - menu content block data
{% enddoc %}

{%- liquid
  assign collection_keys_string = ''

  case block.type
    when 'home-menu'
      assign collection_keys_string = 'summer-mugs,autumn-mugs'
    when 'catalog-menu'
      assign collection_keys_string = 'big-bottle,middle-bottle,'
  endcase

  assign collection_keys = collection_keys_string | split: ','
-%}

{% stylesheet %}
  .menu-content-box {
    display: flex;
    gap: 24px;
    padding: 20px;
  }

  .menu-content-box__filters {
    flex: 0 0 200px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .menu-content-box__filter-btn {
    display: block;
    text-align: left;
    padding: 8px 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .menu-content-box__filter-btn.is-active {
    font-weight: 600;
    text-decoration: underline;
  }

  .menu-content-box__panels {
    flex: 1 1 auto;
  }

  .menu-content-box__panel {
    display: none;
  }

  .menu-content-box__panel.is-active {
    display: block;
  }

  .menu-content-box__product-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-content-box__product-list a {
    text-decoration: none;
  }
{% endstylesheet %}

<div class="menu-content-box" data-menu-content-box>
  <div class="menu-content-box__filters" role="tablist">
    {%- assign first_active = true -%}
    {%- for key in collection_keys -%}
      {%- assign collection = block.settings[key] -%}
      {%- if collection != blank -%}
        <button
          type="button"
          class="menu-content-box__filter-btn{% if first_active %} is-active{% endif %}"
          data-filter-btn
          data-target="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if first_active %}true{% else %}false{% endif %}"
        >
          {{ collection.title | escape }}
        </button>
        {%- assign first_active = false -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="menu-content-box__panels">
    {%- assign first_active = true -%}
    {%- for key in collection_keys -%}
      {%- assign collection = block.settings[key] -%}
      {%- if collection != blank -%}
        <div
          class="menu-content-box__panel{% if first_active %} is-active{% endif %}"
          data-panel="{{ forloop.index0 }}"
          role="tabpanel"
        >
          {%- if collection.products.size > 0 -%}
            <ul class="menu-content-box__product-list">
              {%- for product in collection.products -%}
                <li>
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p>暂无产品</p>
          {%- endif -%}
        </div>
        {%- assign first_active = false -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    if (window.__menuContentBoxInitialized) return;
    window.__menuContentBoxInitialized = true;

    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-filter-btn]');
      if (!button) return;

      var box = button.closest('[data-menu-content-box]');
      if (!box) return;

      var target = button.getAttribute('data-target');

      box.querySelectorAll('[data-filter-btn]').forEach(function (btn) {
        var active = btn === button;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      box.querySelectorAll('[data-panel]').forEach(function (panel) {
        panel.classList.toggle('is-active', panel.getAttribute('data-panel') === target);
      });
    });
  })();
</script>
