{% doc %}
  Renders the header menu's content

  @param {object} [section] - The current header section context, supplied implicitly when rendered from that section and used for menu settings.
  @param {object} [blocks] - menu content blocks data
{% enddoc %}

<div class="menu-content-box">
  {% for block in blocks %}
    {{ block | json }}
  {% endfor %}
</div>
