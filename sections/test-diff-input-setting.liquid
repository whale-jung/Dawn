<div>
  <h3>collection</h3>
  <div style="display: flex; flex-wrap: wrap; gap: 8px;">
    {% for block in section.blocks %}
      <div style="display: inline-block;border: 1px solid #ccc; padding: 4px; margin: 4px;">
        {{ block.settings['test-input'] }}
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "DiffInputSetting",
  "tag": "section",
  "class": "diffInputSetting",
  "settings": [
    {
      "type": "collection",
      "id": "test-collection",
      "label": "Test Collection"
    }
  ],
  "presets": [
    {
      "name": "DiffInputSetting"
    }
  ]
}
{% endschema %}
